<?xml version="1.0" encoding="utf-8"?>
<!-- W31.12 PlexiPlay 风格 legacy 图标(Android 5-7 兜底,所有 density 共用同一 vector)。
     vector 不支持渐变,这里用纯紫底 (#6B3AC0,渐变中点) + 白 play 三角。
     Android 8+ 会用 mipmap-anydpi-v26/ic_launcher.xml 的真渐变 adaptive icon。-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <path
        android:fillColor="#6B3AC0"
        android:pathData="M0,0 L64,0 L64,64 L0,64 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,18 L46,32 L22,46 Z" />
</vector>